# Copie este arquivo para ".env" (na raiz do projeto) e preencha.
# O arquivo .env esta no .gitignore: NUNCA envie suas credenciais ao GitHub.

# Oracle FIAP (usuario e senha do seu RM)
DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521/ORCL
DB_USERNAME=
DB_PASSWORD=

# true = se a tabela PROMESSA nao existir, roda 01_ddl.sql e 02_dml.sql do grupo
DB_INICIALIZAR=false

# Segredo do JWT: texto aleatorio com pelo menos 32 caracteres
JWT_SECRET=

# Primeiro administrador (criado automaticamente se ainda nao existir). Senha com 8+ caracteres.
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
